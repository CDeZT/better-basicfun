{
  "name": "better-basicfun",
  "version": "1.3.0",
  "description": "Host-only DSH foundation helpers: default workspace, resource inspection, and CLIProxyAPI catalog bridging.",
  "author": "CDeZT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CDeZT/better-basicfun.git"
  },
  "homepage": "https://github.com/CDeZT/better-basicfun",
  "bugs": {
    "url": "https://github.com/CDeZT/better-basicfun/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cliproxyapi-bridge": "./lib/cliproxyapi-bridge.js",
    "./core": "./lib/core.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check lib/core.js && node --check lib/index.js && node --check lib/cliproxyapi-bridge.js && node --test",
